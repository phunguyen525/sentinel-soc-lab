let LookbackWindow = 1h;
let FailureThreshold = 5;
let failures =
    SigninLogs
    | where TimeGenerated > ago(LookbackWindow)
    | where ResultType == 50126
    | summarize
        FailureCount = count(),
        FirstFailure = min(TimeGenerated),
        LastFailure  = max(TimeGenerated)
        by UserPrincipalName, IPAddress
    | where FailureCount >= FailureThreshold;
SigninLogs
| where TimeGenerated > ago(LookbackWindow)
| where ResultType == 0
| join kind=inner failures on UserPrincipalName, IPAddress
| where TimeGenerated > LastFailure
| extend
    TimeToCompromise = TimeGenerated - FirstFailure,
    Location = strcat(tostring(LocationDetails.city), ", ", tostring(LocationDetails.countryOrRegion))
| project
    TimeGenerated,
    UserPrincipalName,
    IPAddress,
    Location,
    FailureCount,
    FirstFailure,
    LastFailure,
    TimeToCompromise,
    AppDisplayName,
    UserAgent
| order by TimeGenerated desc
